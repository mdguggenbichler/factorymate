{
  "server_online": {
    "plain": "🌐 {ServerName} is back online.",
    "embed": {
      "title": "🌐 Server is back online",
      "description": "",
      "color": "#5865F2",
      "fields": [
        { "name": "🏭 Factory", "value": "{ServerName}", "inline": true },
        { "name": "🕐 In-game time", "value": "{InGameTime}", "inline": true }
      ],
      "footer": "🏭 {ServerName}",
      "show_timestamp": true
    }
  },
  "server_offline": {
    "plain": "🌐 {ServerName} went offline.",
    "embed": {
      "title": "🌐 Server went offline",
      "description": "",
      "color": "#5865F2",
      "fields": [
        { "name": "🏭 Factory", "value": "{ServerName}", "inline": true },
        { "name": "🕐 In-game time", "value": "{InGameTime}", "inline": true }
      ],
      "footer": "🏭 {ServerName}",
      "show_timestamp": true
    }
  },
  "player_joined": {
    "plain": "👤 **{PlayerName}** joined the server. ({OnlineCount} players online)",
    "embed": {
      "title": "👤 A player joined the server",
      "description": "",
      "color": "#57F287",
      "fields": [
        { "name": "👤 Player", "value": "{PlayerName}", "inline": true },
        { "name": "🏭 Factory", "value": "{ServerName}", "inline": true },
        { "name": "👥 Online", "value": "{OnlineCount} players online", "inline": true }
      ],
      "footer": "🏭 {ServerName}",
      "show_timestamp": true
    }
  },
  "player_left": {
    "plain": "👤 **{PlayerName}** disconnected from the server. ({OnlineCount} players online)",
    "embed": {
      "title": "👤 A player disconnected",
      "description": "",
      "color": "#57F287",
      "fields": [
        { "name": "👤 Player", "value": "{PlayerName}", "inline": true },
        { "name": "🏭 Factory", "value": "{ServerName}", "inline": true },
        { "name": "👥 Online", "value": "{OnlineCount} players online", "inline": true }
      ],
      "footer": "🏭 {ServerName}",
      "show_timestamp": true
    }
  },
  "fuse_tripped": {
    "plain": "⚡ Fuse tripped on circuit {CircuitID}.",
    "embed": {
      "title": "⚡ Fuse tripped on circuit {CircuitID}",
      "description": "",
      "color": "#ED4245",
      "fields": [
        { "name": "🔌 Circuit", "value": "{CircuitID}", "inline": true },
        { "name": "📊 Demand", "value": "{PowerConsumed} / {PowerCapacity} MW", "inline": true },
        { "name": "⚡ Production", "value": "{PowerProduction} MW", "inline": true },
        { "name": "🔋 Batteries", "value": "{BatteryPercent}% · empty in {BatteryTimeEmpty}", "inline": false }
      ],
      "footer": "🏭 {ServerName}",
      "show_timestamp": true
    }
  },
  "power_restored": {
    "plain": "⚡ Power restored on circuit {CircuitID}.",
