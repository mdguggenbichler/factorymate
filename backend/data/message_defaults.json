{
  "server_online": {
    "plain": "🟢 {ServerName} is back online.",
    "embed": {
      "title": "🟢 SERVER ONLINE",
      "description": "**{ServerName}** is reachable again.",
      "color": "#5865F2",
      "fields": []
    }
  },
  "server_offline": {
    "plain": "🔴 {ServerName} is unreachable.",
    "embed": {
      "title": "🔴 SERVER OFFLINE",
      "description": "**{ServerName}** is not responding.",
      "color": "#5865F2",
      "fields": []
    }
  },
  "player_joined": {
    "plain": "🟢 **{PlayerName}** has entered the factory. ({OnlineCount} online)",
    "embed": {
      "title": "🟢 NEW PLAYER DETECTED",
      "description": "**{PlayerName}** has entered the factory.",
      "color": "#57F287",
      "fields": [
        { "name": "Players online", "value": "{OnlineCount}", "inline": true }
      ]
    }
  },
  "player_left": {
    "plain": "🔴 **{PlayerName}** has left the factory. ({OnlineCount} online)",
    "embed": {
      "title": "🔴 PLAYER DISCONNECTED",
      "description": "**{PlayerName}** has left the factory.",
      "color": "#57F287",
      "fields": [
        { "name": "Players online", "value": "{OnlineCount}", "inline": true }
      ]
    }
  },
  "fuse_tripped": {
    "plain": "⚡ Fuse tripped on circuit {CircuitID}.",
    "embed": {
      "title": "⚡ FUSE TRIPPED",
