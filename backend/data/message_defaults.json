        { "name": "📊 Demand", "value": "{PowerConsumed} / {PowerCapacity} MW", "inline": true },
        { "name": "⚡ Production", "value": "{PowerProduction} MW", "inline": true },
        { "name": "🔋 Batteries", "value": "{BatteryPercent}% · empty in {BatteryTimeEmpty}", "inline": false }
      ],
      "footer": "🏭 {ServerName}",
      "show_timestamp": true
    }
  },
