# Backend (see docs/factorymate-spec.md §9)
PORT=8080
DATABASE_PATH=./data/factorymate.db
SESSION_SECRET=change-me-to-a-long-random-string

# FRM — seeded into app_settings on first boot if unset (editable via UI later)
FRM_HOST=
FRM_PORT=8080

# Frontend dev — direct backend URL (production uses same-origin /api proxy)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Next.js production rewrite target (docker-compose sets http://backend:8080)
BACKEND_URL=http://localhost:8080

# Optional: live integration tests (see docs/testing.md)
# FRM_TEST_HOST=192.168.178.42
# FRM_TEST_PORT=8889
# FRM_TEST_TOKEN=
# DISCORD_TEST_WEBHOOK_URL=
