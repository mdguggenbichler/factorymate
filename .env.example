# Backend (see docs/factorymate-spec.md §9)
PORT=8080
DATABASE_PATH=./data/factorymate.db
SESSION_SECRET=change-me-to-a-long-random-string

# FRM — seeded into app_settings on first boot if unset (editable via UI later)
# For local dev against the group's live save, use the home-server FRM port (mapped from container 8080 → 8889)
FRM_HOST=192.168.178.42
FRM_PORT=8889

# Frontend dev — direct backend URL (production uses same-origin /api proxy)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Next.js production rewrite target (local dev; Docker sets http://127.0.0.1:8080 automatically)
BACKEND_URL=http://localhost:8080

# Docker Compose host port for the single factorymate service (default 3000)
# FACTORYMATE_PORT=3000

# Discord bot — required for notifications, slash commands, and DMs (see docs/guide/discord/)
# DISCORD_BOT_TOKEN=
# DISCORD_CLIENT_SECRET=
# DISCORD_GUILD_ID=
# DISCORD_ADMIN_ROLE_IDS=123456789,987654321

# Public dashboard URL — required for Discord OAuth redirect and bot welcome/help copy
# FACTORYMATE_PUBLIC_URL=https://factorymate.example.com

# Live FRM integration tests + fixture capture (read-only GET — see .cursor/rules/04-frm-live.mdc)
FRM_TEST_HOST=192.168.178.42
FRM_TEST_PORT=8889
# FRM_TEST_TOKEN=

# Factory planner (M19+) — paths relative to backend/ working directory unless absolute
PLANNER_DOCS_PATH=../docs/FactoryGame-Docs.json
PLANNER_CATALOG_PATH=testdata/planner/factory_catalog.json
PLANNER_ICONS_DIR=../assets/icons
PLANNER_ICONS_JSON=../assets/icons.json
# DISCORD_TEST_WEBHOOK_URL=
